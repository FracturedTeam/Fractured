  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Here I am staring at the ocean.\\n What was once the fuel for our fantasies
    has become your grave.\\n Reality tore us apart, and unlike you, I didn\u2019t
    have the strength to pull myself back together.\\n I can only hope to carry your
    name and your dreams far with me wherever I go.\\n The weight of my actions will
    forever be a heavy load to bear, I know that.\\n But, for your sake and for mine,
    I will do my best to not let that stop me.\\n And I hope that the next time we
    see each other, I can be forgiven.\\n I\u2019m sorry. Arthur, I am sorry."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 55a0db4c9606c494f882d1ee984623b6, type: 2}
  m_sharedMaterial: {fileID: 8467428810394340168, guid: 55a0db4c9606c494f882d1ee984623b6, type: 2}
