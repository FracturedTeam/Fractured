  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "And I hope that the next time we see each other, I can be forgiven.\\n
    I\u2019m sorry. Arthur, I am sorry."
