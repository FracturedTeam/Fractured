  m_Script: {fileID: 11500000, guid: 9c11565ed30c423d954c0a13a178c865, type: 3}
  m_Name: SO_4_1_Thought_ElizabethChair
  m_EditorClassIdentifier: Assembly-CSharp::GlassTextScriptableObject
  baseText: 'When Father took the book pile away from us, we managed to save one
    book by hiding it upstairs. It was our favourite one. '
  fragAText: 
  fragBText: 'The housemaid, Elizabeth, would sit in this chair to read us this book,
    while Arthur and I sat at her feet. '
  bothText: 
