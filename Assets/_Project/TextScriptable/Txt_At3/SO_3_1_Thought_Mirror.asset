  m_Script: {fileID: 11500000, guid: 9c11565ed30c423d954c0a13a178c865, type: 3}
  m_Name: SO_3_1_Thought_Mirror
  m_EditorClassIdentifier: Assembly-CSharp::GlassTextScriptableObject
  baseText: My brother always stood near the portrait to watch Mother leave for one
    of her parties. She wasn't often home anyway...
  fragAText: 
  fragBText: He wanted her attention so bad, he would snitch on me about my bad grades,
    probably in hopes she would stay. She didn't really care though.
  bothText: 
