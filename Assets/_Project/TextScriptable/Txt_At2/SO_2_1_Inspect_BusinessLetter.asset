  m_Script: {fileID: 11500000, guid: cf81f5a533b8fa74aa32a39834a63199, type: 3}
  m_Name: SO_2_1_Inspect_BusinessLetter
  m_EditorClassIdentifier: Assembly-CSharp::GlassDocumentScriptableObject
  baseText: "<align=justified>Dear Monsieur Montbury,\u2014 I know it isn't customary
    to write an introduction letter about one's own self, but I was very impressed
    about what I heard about your family. I am Jean- Baptiste Lemarchand, a French
    merchant currently looking to expand business opportunities for the shipping
    firm I work for, Mercier & Co, which you may have heard of. Mercier & Co owns
    various harbours, mainly in the north of France and we are looking to develop
    our firm internationally. I would be delighted to arrange a meeting with you,
    to discuss in depth the possibility of a partnership between my firm and your
    family. <br><align=\"center\">Respectfully yours, <br><align='right'>JEAN-BAPTISTE
    LEMARCHAND. "
  fragAText: "<align='justified'>Dear Monsieur Montbury,\u2014 I know it isn't customary
    to write an introduction letter about one's own self, but I heard of you and
    your family's business and reputation thanks to your son, Arthur. I met him after
    reading his excellent financial essay. We talked for quite some time until he
    mentionned your various harbour activities, which compelled me to contact you.
    I am Jean- Baptiste Lemarchand, a French merchant currently looking to expand
    business opportunities for the shipping firm I work for, Mercier & Co, which
    you may have heard of. Mercier & Co owns various harbours, mainly in the north
    of France and we are looking to develop our firm internationally. I would be 
    delighted to arrange a meeting with you, to discuss in depth the possibility
    of a partnership between my firm and your family. <br><align='center'>Respectfully
    yours, <br><align='right'>JEAN-BAPTISTE LEMARCHAND."
  fragBText: 
  bothText: 
  material: {fileID: 2100000, guid: 9a3b3fe8982a9104683620028615dc94, type: 2}
  type: 2
