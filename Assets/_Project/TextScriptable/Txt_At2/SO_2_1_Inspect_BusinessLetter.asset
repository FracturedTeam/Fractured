  m_Script: {fileID: 11500000, guid: cf81f5a533b8fa74aa32a39834a63199, type: 3}
  m_Name: SO_2_1_Inspect_BusinessLetter
  m_EditorClassIdentifier: Assembly-CSharp::GlassDocumentScriptableObject
  baseText: 
  fragAText: "<align=justified>Dear Monsieur Montbury,\u2014My name is Olivier Delafoy
    and I am writing to you on behalf of the shipping firm I represent, Mercier &
    Co. We would be very interested in speaking with you about your family's business
    as we look for the highest quality when it comes to where our ships dock. <br>
    <link='censored'> For my interest you can thank your son, Arthur, whom I met
    after reading his excellent financial essay. We talked for quite some time until
    he mentionned your various harbour activities, which compelled me to contact
    you.</link> <br> We are currently looking to expand our reaches to trade with
    English merchants and you seem to be our best option so far. I would be delighted
    to arrange a meeting with you in order to discuss in depth the possibility of
    a future partnership. <br> <align=center>Respectfully yours, <br> <align=right>OLIVIER
    DELAFOY"
  fragBText: 
  bothText: 
  material: {fileID: 2100000, guid: add3a1252c2576b4aab2b45043bf7f63, type: 2}
  type: 2
