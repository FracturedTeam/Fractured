      propertyPath: m_text
      value: <color=#ffffffff>According to Father, cigars are the key to fluid negotiations.
        They put the boxes on the tables to have easy access while chatting. He sealed
        one of his biggest deals with a frenchman with this technique.</color>
      objectReference: {fileID: 0}
