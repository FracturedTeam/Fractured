    - target: {fileID: 3344555599455988294, guid: d73fa5b99c3798b4d99ec6d6d075a3b7, type: 3}
      propertyPath: m_text
      value: <mspace=0.5em><color=#ffffffff><link='censored'>I just couldn't control
        my anger. I stood in front of the car and quicked it again and again and
        again. I was so blinded by my rage I didn't see the screw fall. Was the screw
        important? Did I break the car? </color></mspace></link>
      objectReference: {fileID: 0}
