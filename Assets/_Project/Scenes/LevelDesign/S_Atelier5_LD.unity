    - target: {fileID: 4461744898393978638, guid: d73fa5b99c3798b4d99ec6d6d075a3b7, type: 3}
      propertyPath: m_text
      value: <mspace=0.5em><color=#ffffffff><link='censored'> When I came in, the
        car was parked in the middle of the room, as usual. I was so angry and seeing
        it felt like Arthur's achievements and my "uselessness" were being rubbed
        in my face.</color></mspace></link>
      objectReference: {fileID: 0}
